# Copy to .env and edit. Never commit .env.

# --- Basics ---------------------------------------------------------------
PORT=7000
# Public HTTPS address of the addon (used to build playback URLs).
PUBLIC_BASE_URL=https://stremio.example.com
NGUONC_API_BASE=https://phim.nguonc.com/api
API_TIMEOUT_MS=9000
RESOLVE_EMBEDS=1

# --- Vietnamese egress (needed when the server is outside Vietnam) ----------
# NguonC and StreamC block non-Vietnamese IPs. Point this at one or more HTTP
# CONNECT proxies that exit from a Vietnamese IP (e.g. relay/relay.py on a home PC,
# reached over Tailscale/WireGuard). Leave empty if the server is in Vietnam.
# Comma-separated name=url list; the fastest healthy proxy is used, with failover.
UPSTREAM_PROXIES=
# Legacy single-proxy setting (still accepted when UPSTREAM_PROXIES is empty).
UPSTREAM_PROXY=
# Health/latency probe interval per proxy, in seconds.
PROXY_PROBE_SEC=600
# URL fetched by that probe (empty = NguonC newest uploads, page 1).
PROXY_PROBE_URL=
# Minimum gap between requests to one site through the proxies (rate-limit friendly).
PROXY_MIN_GAP_MS=nguonc.com=400,streamc.xyz=800
# Cooldown for a proxy after a 429 without Retry-After, in seconds.
PROXY_429_SEC=60
# Only these domains go through the proxy; video CDNs stay direct.
UPSTREAM_PROXY_HOSTS=nguonc.com,streamc.xyz
# HTTP/2 fallback for StreamC. Forced off whenever a proxy above is set (it would
# bypass the proxy); only matters for servers inside Vietnam.
STREAMC_HTTP2=0

# --- Cloudflare edge relay for video segments (optional, recommended) -------
# Random secret shared with the Cloudflare Worker (see cloudflare/).
# Generate with: openssl rand -hex 32
EDGE_SECRET=
# 1 = video segments served by the Worker at the edge; 0 = served by this server.
EDGE_RELAY=1

# --- Access ------------------------------------------------------------------
# Optional private addon: when set, install https://<host>/<token>/manifest.json
# instead (all catalog/meta/stream routes need the prefix; /play/ and /health do not).
# Generate with: openssl rand -hex 16. Changing it means reinstalling the addon.
ACCESS_TOKEN=
# Deepest catalog `skip` served; beyond it a catalog ends instead of repeating.
CATALOG_MAX_SKIP=200

# --- Playback sessions --------------------------------------------------------
# Where resolved playlists are kept so /play/ URLs survive restarts (empty = memory only).
PLAYBACK_DIR=/app/data/playback
# Sessions kept in memory (least recently used leave first) and files kept on disk.
PLAYBACK_MAX_SESSIONS=80
PLAYBACK_MAX_FILES=500
# Secret for stable session ids across restarts (defaults to EDGE_SECRET).
PLAYBACK_SECRET=

# --- Speed / background work -------------------------------------------------
# Refresh catalogs + top film details every N minutes (0 = off).
WARM_INTERVAL_MIN=30
# Pre-resolve streams for the top N movies of each movie catalog.
WARM_STREAMS=3
# Resolved stream links are reused for N minutes. Keep it above WARM_INTERVAL_MIN so
# the warm-up does not re-resolve the same movies at StreamC on every run.
RESOLVE_CACHE_MIN=45
# Pre-resolve the next N episodes while an episode is being watched.
PREFETCH_NEXT_EPISODES=2
# Parallel upstream API requests (1..16).
API_CONCURRENCY=2
# Max cached upstream API responses.
API_CACHE_MAX=3000
# Max upstream search pages walked per query, and how long ranked results are cached.
SEARCH_MAX_PAGES=6
SEARCH_CACHE_SEC=600

# --- NguonC tab on IMDb titles (Cinemeta etc.) ------------------------------
# 0 disables IMDb matching entirely.
IMDB_MATCH=1
# Persisted IMDb -> NguonC index and matches.
IMDB_CACHE_FILE=/app/data/imdb-cache.json
# Background pre-matching of popular titles every N hours (0 = off).
IMDB_PREFETCH_HOURS=24
# Delay before the first pre-matching run after start, in seconds.
IMDB_PREFETCH_DELAY_SEC=900
# How many pages of newest NguonC uploads to index per run.
IMDB_INDEX_PAGES=5
# How many pre-matched titles get their streams pre-resolved.
IMDB_PREFETCH_STREAMS=5
# Upstream search pages tried per title when matching.
IMDB_SEARCH_PAGES=8
# Cinemeta endpoint used for IMDb titles (empty = https://v3-cinemeta.strem.io).
CINEMETA_URL=
