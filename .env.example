# Copy to .env and edit. Never commit .env.

# --- Basics ---------------------------------------------------------------
PORT=7000
# Public HTTPS address of the addon (used to build playback URLs).
PUBLIC_BASE_URL=https://stremio.example.com
NGUONC_API_BASE=https://phim.nguonc.com/api
API_TIMEOUT_MS=9000
RESOLVE_EMBEDS=1

# --- Vietnamese egress (needed when the server is outside Vietnam) ----------
# NguonC and StreamC block non-Vietnamese IPs. Point this at an HTTP CONNECT
# proxy that exits from a Vietnamese IP (e.g. relay/relay.py on a home PC,
# reached over Tailscale/WireGuard). Leave empty if the server is in Vietnam.
UPSTREAM_PROXY=
# Only these domains go through the proxy; video CDNs stay direct.
UPSTREAM_PROXY_HOSTS=nguonc.com,streamc.xyz
# Must be 0 when UPSTREAM_PROXY is set (the HTTP/2 path bypasses the proxy).
STREAMC_HTTP2=0

# --- Cloudflare edge relay for video segments (optional, recommended) -------
# Random secret shared with the Cloudflare Worker (see cloudflare/).
# Generate with: openssl rand -hex 32
EDGE_SECRET=
# 1 = video segments served by the Worker at the edge; 0 = served by this server.
EDGE_RELAY=1

# --- Speed / background work -------------------------------------------------
# Refresh catalogs + top film details every N minutes (0 = off).
WARM_INTERVAL_MIN=8
# Pre-resolve streams for the top N movies of each movie catalog.
WARM_STREAMS=10
# Resolved stream links are reused for N minutes.
RESOLVE_CACHE_MIN=30
# Pre-resolve the next N episodes while an episode is being watched.
PREFETCH_NEXT_EPISODES=2

# --- NguonC tab on IMDb titles (Cinemeta etc.) ------------------------------
# 0 disables IMDb matching entirely.
IMDB_MATCH=1
# Persisted IMDb -> NguonC index and matches.
IMDB_CACHE_FILE=/app/data/imdb-cache.json
# Background pre-matching of popular titles every N hours (0 = off).
IMDB_PREFETCH_HOURS=3
# How many pages of newest NguonC uploads to index per run.
IMDB_INDEX_PAGES=20
# How many pre-matched titles get their streams pre-resolved.
IMDB_PREFETCH_STREAMS=20
