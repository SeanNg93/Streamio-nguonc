# nginx site for the addon. Replace stremio.example.com with your hostname.
# Certificates: certbot certonly --webroot -w /var/www/acme -d stremio.example.com
#
# Optional, in the http {} context (e.g. /etc/nginx/conf.d/log-format-stremio.conf):
# log_format stremio '$remote_addr edge=$realip_remote_addr [$time_local] $host '
#                    '"$request_method $request_uri $server_protocol" $status $body_bytes_sent '
#                    'rt=$request_time urt=$upstream_response_time "$http_referer" "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name stremio.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name stremio.example.com;

    ssl_certificate     /etc/letsencrypt/live/stremio.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stremio.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Behind Cloudflare: log the real client instead of the edge node. Add one
    # set_real_ip_from per range from https://www.cloudflare.com/ips-v4 and /ips-v6.
    # set_real_ip_from 173.245.48.0/20;
    # real_ip_header CF-Connecting-IP;
    # access_log /var/log/nginx/stremio.access.log stremio;

    location / {
        proxy_pass http://127.0.0.1:7000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;          # stream playlists/segments immediately
        proxy_read_timeout 300s;
    }
}
