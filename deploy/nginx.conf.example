# nginx site for the addon. Replace stremio.example.com with your hostname.
# Certificates: certbot certonly --webroot -w /var/www/acme -d stremio.example.com

server {
    listen 80;
    listen [::]:80;
    server_name stremio.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name stremio.example.com;

    ssl_certificate     /etc/letsencrypt/live/stremio.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stremio.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:7000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;          # stream playlists/segments immediately
        proxy_read_timeout 300s;
    }
}
